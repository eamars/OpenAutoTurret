# OpenAutoTurret — CAN bus supervisor (independent recovery watchdog).
#
# Watches can0 (MCP2515 HAT) and runs the bounded recovery ladder:
#   restart-ms re-arm -> SocketCAN restart -> down/up -> mcp251x unbind/rebind
#   -> (optional GPIO RESET, not wired) -> reboot (disabled by default).
# Never touches the daemon; only touches can0 on fault. State/verdict:
#   /tmp/ota_can_supervisor.json ; log: /tmp/ota_can_supervisor.log ;
#   diagnostics: /tmp/ota_can_diag/.
#
# Template (architecture §52 style): adjust paths for the install root
# (default /opt/open_auto_turret), enable at P11.
[Unit]
Description=OpenAutoTurret CAN0 supervisor (MCP2515 recovery watchdog)
After=can0.service
Wants=can0.service
Before=turret-control.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/open_auto_turret/tools/can_supervisor.py \
    --iface can0 --bitrate 1000000 --restart-ms 100 --daemon-proc controld
Restart=always
RestartSec=5
# The supervisor must never reboot the station on its own:
Environment=OTA_CAN_SUPERVISOR_ALLOW_REBOOT=0
# Run as root: the L3 rebind needs write access to /sys/bus/spi/drivers.
User=root
Group=root

[Install]
WantedBy=multi-user.target
