# OpenAutoTurret — web UI / diagnostics (webd, §5.3, §42, §53).
#
# FastAPI/Uvicorn over the LAN. It reads controld's telemetry and submits
# high-level developer commands through controld's validation gate; it NEVER
# opens can0. Motor control does not depend on this process (§53): if the web
# UI is down or the network fails, the deterministic local tracking loop is
# unaffected.
#
# §53: bind host, port, and the controld socket are configuration (env), never
# hard-coded — access is by hostname, not IP.
#
# CHANGE before deploy: User/Group, the install root, and the venv python path.
[Unit]
Description=OpenAutoTurret web UI (webd)
After=network.target turret-control.service
Wants=turret-control.service

[Service]
Type=simple
User=eamars
Group=eamars
WorkingDirectory=/opt/open_auto_turret
ExecStart=/opt/open_auto_turret/.venv/bin/python -m web.webd.app
# §53: nothing hard-coded — host/port/socket/rate are env configuration.
Environment=OTA_WEB_HOST=0.0.0.0
Environment=OTA_WEB_PORT=8080
Environment=OTA_WEB_SOCKET=/run/ota/controld-web.sock
Environment=OTA_WEB_HZ=15
# This install: IMX500 is mounted upside-down; rotate_180 is the
# live-verified correction (0.9996 correlation; see run_webd_inspection.py).
# Without it the web feed (and any capture from this unit) is flipped.
Environment=OTA_VIDEO_ORIENTATION=rotate_180
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
