# OpenAutoTurret — web UI / diagnostics (webd, §5.3, §42, §53).
#
# FastAPI/Uvicorn over the LAN. It reads controld's telemetry and submits
# high-level developer commands through controld's validation gate; it NEVER
# opens can0. Motor control does not depend on this process (§53): if the web
# UI is down or the network fails, the deterministic local tracking loop is
# unaffected.
#
# §53: bind host, port, and the controld socket are configuration (env), never
# hard-coded — access is by hostname, not IP.
#
# CHANGE before deploy: User/Group and the /opt/open_auto_turret install root.
#
# ⚠ INTERPRETER: the SYSTEM python (/usr/bin/python3). The repo venv has no
# uvicorn (verified by import 2026-09-03), and its picamera2 import fails too, so
# `.venv/bin/python -m web.webd.app` cannot serve the UI — let alone the video
# feed. The live-verified runbook uses system python3 for exactly this reason.
[Unit]
Description=OpenAutoTurret web UI (webd)
After=network.target turret-control.service
Wants=turret-control.service

[Service]
Type=simple
User=eamars
Group=eamars
WorkingDirectory=/opt/open_auto_turret
ExecStart=/usr/bin/python3 -m web.webd.app
# §53: nothing hard-coded — host/port/socket/rate are env configuration.
Environment=OTA_WEB_HOST=0.0.0.0
Environment=OTA_WEB_PORT=8080
Environment=OTA_WEB_SOCKET=/run/ota/controld-web.sock
Environment=OTA_WEB_HZ=15
# This install: IMX500 is mounted upside-down; rotate_180 is the
# live-verified correction (0.9996 correlation; see run_webd_inspection.py).
# Without it the web feed (and any capture from this unit) is flipped.
Environment=OTA_VIDEO_ORIENTATION=rotate_180

# §80 scene artifacts are OFF unless this names a directory, and that default is deliberate (writing
# files is a side effect that should not arrive merely because code was merged). It is left commented
# so enabling it stays an operator decision, but it is spelled out here because the alternative is the
# silent case: with no path, controld still captures and webd still publishes the scene on every unsafe
# edge, and NOTHING is ever written to disk - the feature is inert in production while every test stays
# green. A station whose brake incidents this operator wants to review should uncomment the line.
# Weigh it first: the writer has no rotation and no delete path (one scene is ~856 B, and a single
# probing session on this machine produced 128 of them), and the directory must be writable by the
# user this unit runs as.
#Environment=OTA_BLACKBOX_DIR=/var/lib/ota/blackbox
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
