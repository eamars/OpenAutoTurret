{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "ADR-002.2 verification profile binding",
  "properties": {
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "hardware_signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "measurement_signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "core_build_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "observer_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parameters_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "metrics_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "test_spec_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "envelope_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "axes": {
      "type": "array",
      "items": {
        "enum": [
          "yaw",
          "pitch"
        ]
      },
      "uniqueItems": true,
      "minItems": 2,
      "maxItems": 2
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "required_cases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    }
  },
  "required": [
    "candidate_id",
    "hardware_signature",
    "measurement_signature",
    "core_build_hash",
    "observer_hash",
    "model_hash",
    "parameters_hash",
    "metrics_hash",
    "test_spec_hash",
    "envelope_hash",
    "axes",
    "conditions",
    "required_cases"
  ]
}
