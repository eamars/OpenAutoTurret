{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "ADR-002.2 per-environment validation metadata",
  "properties": {
    "stage": {
      "enum": [
        "3a",
        "3b"
      ]
    },
    "program": {
      "enum": [
        "commissiond",
        "production"
      ]
    },
    "route": {
      "enum": [
        "independent_shared_core",
        "normal_production_chain",
        "shadow",
        "bypass"
      ]
    },
    "execution": {
      "enum": [
        "physical",
        "synthetic",
        "replay"
      ]
    },
    "shadow": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN"
      ]
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "hardware_signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "measurement_signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "core_build_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "observer_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parameters_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "metrics_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "test_spec_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "envelope_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "actual_parameters_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "binary_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "trace_hashes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "minItems": 1
    },
    "unresolved_abort": {
      "type": "boolean"
    },
    "coverage": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "axis": {
            "enum": [
              "yaw",
              "pitch"
            ]
          },
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "case": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "INVALID_DATA"
            ]
          },
          "valid_data": {
            "type": "boolean"
          },
          "repetitions": {
            "type": "integer",
            "minimum": 0
          },
          "operating_point_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "axis",
          "condition",
          "case",
          "status",
          "valid_data",
          "repetitions",
          "operating_point_hash"
        ]
      },
      "minItems": 1
    },
    "production_load_verified": {
      "type": "boolean"
    },
    "lifecycle_verified": {
      "type": "boolean"
    },
    "parity_passed": {
      "type": "boolean"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "bench_certificate_hash": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    }
  },
  "required": [
    "stage",
    "program",
    "route",
    "execution",
    "shadow",
    "status",
    "candidate_id",
    "hardware_signature",
    "measurement_signature",
    "core_build_hash",
    "observer_hash",
    "model_hash",
    "parameters_hash",
    "metrics_hash",
    "test_spec_hash",
    "envelope_hash",
    "actual_parameters_hash",
    "binary_hash",
    "trace_hashes",
    "unresolved_abort",
    "coverage",
    "production_load_verified",
    "lifecycle_verified",
    "parity_passed",
    "started_at",
    "finished_at",
    "bench_certificate_hash"
  ]
}
